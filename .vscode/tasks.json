{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "C:/Program Files/CMake/bin/cmake.exe",
            "args": [
                "-B",
                "${workspaceFolder}/cmake-build-win",
                "-S",
                "${workspaceFolder}",
                "-G",
                "Visual Studio 16 2019",
                "-A",
                "x64"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "配置 CMake 项目 (VS2019)。添加新文件后必须重新运行！"
        },
        {
            "label": "CMake: Clean Configure",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Remove-Item -Recurse -Force ${workspaceFolder}/cmake-build-win -ErrorAction SilentlyContinue;",
                "&",
                "'C:/Program Files/CMake/bin/cmake.exe'",
                "-B",
                "${workspaceFolder}/cmake-build-win",
                "-S",
                "${workspaceFolder}",
                "-G",
                "Visual Studio 16 2019",
                "-A",
                "x64"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "清理并重新配置 CMake（解决链接错误时使用）"
        },
        {
            "label": "Build: runtime",
            "type": "shell",
            "command": "C:/Program Files (x86)/Microsoft Visual Studio/2019/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}/cmake-build-win/Blast.sln",
                "/target:runtime",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "构建 runtime 目标（主程序，链接全部模块）"
        },
        {
            "label": "Build: All",
            "type": "shell",
            "command": "C:/Program Files (x86)/Microsoft Visual Studio/2019/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}/cmake-build-win/Blast.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "构建所有目标"
        }
    ]
}
